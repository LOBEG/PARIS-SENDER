# Paris Sender local configuration example
# Copy to .env for local use. Never commit real values.

# Fernet encryption key for secrets at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARIS_SECRET_KEY=
# Optional comma-separated key list for decrypting older Fernet tokens during rotation.
PARIS_SECRET_KEYS=

# JWT auth is opt-in via create_app(enable_auth=True). Use a strong random value in production.
PARIS_JWT_SECRET=

# SMTP placeholders for local provider wiring.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true
SMTP_USE_SSL=false
