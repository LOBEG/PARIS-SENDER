{
  "name": "paris-sender-electron",
  "version": "0.2.0",
  "private": true,
  "description": "Phase 2 Electron + React frontend for Paris Sender",
  "main": "main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "build": {
    "appId": "com.parissender.app",
    "productName": "Paris Sender",
    "directories": {
      "output": "out"
    },
    "files": [
      "main/**/*",
      "dist/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
